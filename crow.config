# Crow project memory. This file is safe to commit to a public repository.
# Provider endpoints and credentials remain in Raven or the private overlay.

spec_version: "1.0"

project:
  id: "wwwsqldesigner"
  name: "WWW SQL Designer"
  repository:
    provider: "github"
    owner: "bcgov"
    name: "wwwsqldesigner"
    visibility: "public"

sonar:
  projectKey: "wwwsql"
  projectName: "WWW SQL Designer"
  useMsBuild: true
  runTests: true
  exclusions:
    - "WwwSqlDesigner/Migrations/**"

# Azure DevOps references are symbolic so internal service URLs are not
# published in this manifest.
ci_cd:
  - id: "primary-build"
    provider: "azure-devops"
    lookup:
      mode: "provider"
      connection_ref: "raven:ci-cd"
      resource_ref: "crow:ci:wwwsqldesigner-build"
    discovered:
      source: "azure-devops"
      recorded_by: "crow"
      recorded_on: "2026-09-14"

  - id: "primary-release"
    provider: "azure-devops"
    lookup:
      mode: "provider"
      connection_ref: "raven:ci-cd"
      resource_ref: "crow:cd:wwwsqldesigner-release"
    discovered:
      source: "user"
      recorded_by: "crow"
      recorded_on: "2026-09-14"

work_tracking:
  - id: "primary"
    provider: "azure-devops"
    lookup:
      mode: "provider"
      connection_ref: "raven:work-tracking"
      resource_ref: "crow:work-tracking:wwwsqldesigner"
      issue_query_ref: "crow:work-tracking:wwwsqldesigner-board"
    discovered:
      source: "azure-devops"
      recorded_by: "crow"
      recorded_on: "2026-09-14"

related_repositories:
  - id: "original-wwwsql-designer"
    provider: "github"
    owner: "ondras"
    name: "wwwsqldesigner"
    visibility: "public"
    relationship: "Original upstream project"

documentation:
  - id: "readme"
    source: "local"
    path: "README.md"
  - id: "compliance"
    source: "local"
    path: "COMPLIANCE.yaml"

memory_policy:
  visibility: "public-reference-only"
  private_overlay: "~/.crow/crow.config.local"
  allowed_values:
    - "provider names"
    - "public repository owner/name"
    - "repository-relative paths"
    - "workflow or pipeline names confirmed public"
    - "symbolic connection_ref and resource_ref names"
  forbidden_values:
    - "internal URLs or hostnames"
    - "credentials, tokens, passwords, or secret values"
    - "absolute local paths"
    - "provider response bodies"
  update_rule: "When a user supplies a resource URL, retain only a safe provider/repository/path descriptor or a symbolic resource_ref; keep the URL in Raven/provider storage or the private overlay."
